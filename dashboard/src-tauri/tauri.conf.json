{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxy Router",
  "version": "0.1.0",
  "identifier": "local.proxyrouter.dashboard",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
  "app": {"windows": [{"label":"main","title":"Proxy Router","width":1440,"height":900,"resizable":false}], "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"}},
  "bundle": {"active": true,"targets": ["app"],"icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]}
}
